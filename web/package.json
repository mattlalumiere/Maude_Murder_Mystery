{
  "name": "murder-mystery-night-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:security": "vitest run --project security",
    "test:scale": "vitest run --project scale",
    "test:bdd": "NODE_OPTIONS=\"--import tsx\" cucumber-js",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:smoke && vitest run && npm run test:bdd",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-polly": "^3.1156.0",
    "@aws-sdk/client-rekognition": "^3.1153.0",
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "next": "^15.1.0",
    "next-auth": "5.0.0-beta.25",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cucumber/cucumber": "^11.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
