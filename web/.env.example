# Copy to web/.env.local for `npm run dev`. Containers use deploy/local/.env instead.
# Every adapter is chosen by environment only; defaults work with zero configuration.

# Auth.js (hosts only). Generate with: npx auth secret
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
# Passwordless dev login (local only, never in production)
ALLOW_DEV_LOGIN=true

# State store: memory | file | postgres | dynamo (legacy, deprecated)
STORE_ADAPTER=memory
STORE_FILE_DIR=./.data/state
DATABASE_URL=

# Blob store: file | s3
MEDIA_ADAPTER=file
MEDIA_FILE_DIR=./.data/media
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_FORCE_PATH_STYLE=

# Placement
CELL_ID=local-0
REGION_ID=local

# AI text: openai-compatible | bedrock (legacy) | sample
AI_TEXT_ADAPTER=sample
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=4096

# Pictures and video: mock | bedrock (legacy)
MEDIA_PROVIDER=mock

# AI guest voices. browser = free, the player's or TV's browser speaks. Cloud voices follow the selected cloud:
#   CLOUD_PROVIDER=aws -> Amazon Polly; azure -> Azure AI Speech (needs the key and region below).
# SPEECH_ADAPTER overrides: browser | mock | polly | azure | openai-compatible
SPEECH_ADAPTER=
CLOUD_PROVIDER=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
SPEECH_MODEL=
POLLY_ENGINE=neural

# Saved stories (kept after the game ends). Sealed with STORY_SEAL_KEY (32 bytes, base64: openssl rand -base64 32);
# if unset, a key is derived from AUTH_SECRET. On S3, STORY_BUCKET must be a bucket WITHOUT an expiry rule.
STORY_FILE_DIR=./.data/stories
STORY_BUCKET=
STORY_SEAL_KEY=

# Local AI services (services/local-ai): chat, voices, pictures and video behind one MCP endpoint.
# Set the URL to let hosts pick "Local services" for a game. Token is optional on one machine, required on a network.
LOCAL_AI_MCP_URL=
LOCAL_AI_TOKEN=
LOCAL_VIDEO_FRAMES=3

GAME_TTL_HOURS=24
LOG_LEVEL=info

# --- Legacy (keep working, do not use in new code) ---
ROOMS_TABLE=
MEDIA_BUCKET=
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
IMAGE_MODEL_ID=amazon.nova-canvas-v1:0
VIDEO_MODEL_ID=amazon.nova-reel-v1:1

# --- Proposed, pending contract approval (see docs/platform/feedback/to-W7-from-W8.md) ---
# Public URL used in join links and QR codes, e.g. http://192.168.1.20:3000
PUBLIC_BASE_URL=
