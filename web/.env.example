# Auth.js (hosts only). Generate with: npx auth secret
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
# Enables a passwordless dev login outside production (never set in prod)
ALLOW_DEV_LOGIN=true

# Storage: leave blank locally (in-memory). On AWS set the table name.
ROOMS_TABLE=
# Bedrock case generation: leave blank to use the built-in sample case.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
