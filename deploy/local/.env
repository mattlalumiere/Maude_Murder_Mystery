# Copy to deploy/local/.env (scripts/up.sh does this for you and generates AUTH_SECRET).
# .env is git-ignored. Never commit real values.

# Generated on first run by scripts/up.sh
AUTH_SECRET=NcJFjAIasOc/azIzHPkz3uKvdqgBbFHTPuWMWarL9Rs=

# Local AI. Host mlx_lm.server on 8080, Ollama on 11434 (use model qwen3.8:27b-mlx).
AI_BASE_URL=http://host.docker.internal:8080/v1
AI_MODEL=mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit
# AI_API_KEY=

# Port published on the Mac
WEB_PORT=3000

# Set to http://<your LAN IP>:3000 so QR codes and join links work on phones (needs app support, see docs)
PUBLIC_BASE_URL=

